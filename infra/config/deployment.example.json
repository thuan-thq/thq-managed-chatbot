{
  "clientId": "example-client",
  "region": "ap-southeast-2",
  "modelId": "au.anthropic.claude-sonnet-4-5-20250929-v1:0",
  "confidenceThreshold": 0.3,
  "dataSource": {
    "type": "strapi",
    "baseUrl": "https://cms.example.com",
    "apiToken": "your-api-token-here",
    "webhookSecret": "your-webhook-secret-here",
    "frontendBaseUrl": "https://staging.intranet.think-hq.com.au",
    "pageSize": 100
  },
  "strapi": {
    "baseUrl": "https://cms.example.com",
    "apiToken": "YOUR_STRAPI_API_TOKEN",
    "webhookSecret": "YOUR_WEBHOOK_SECRET",
    "frontendBaseUrl": "https://www.example.com",
    "pageSize": 100,
    "collections": [
      {
        "name": "articles",
        "strapiUid": "api::article.article",
        "markdownStrategy": "content-blocks",
        "fieldMappings": {
          "titleFields": ["title"],
          "slugField": "slug",
          "summaryField": "summary",
          "contentBlocksField": "content_blocks",
          "lastModifiedField": "updatedAt"
        },
        "urlPathTemplate": "/articles/{slug}",
        "populate": {
          "fields": [
            {
              "key": "populate[content_blocks][on][dynamic.text-block][populate]",
              "value": "*"
            }
          ]
        }
      },
      {
        "name": "blog-posts",
        "strapiUid": "api::blog-post.blog-post",
        "markdownStrategy": "rich-text",
        "fieldMappings": {
          "titleFields": ["title"],
          "slugField": "slug",
          "richTextField": "body",
          "lastModifiedField": "updatedAt"
        },
        "urlPathTemplate": "/blog/{slug}"
      },
      {
        "name": "faqs",
        "strapiUid": "api::faq.faq",
        "markdownStrategy": "flat-fields",
        "fieldMappings": {
          "titleFields": ["question"],
          "flatFields": ["question", "answer"],
          "lastModifiedField": "updatedAt"
        },
        "urlPathTemplate": "/faqs/{slug}"
      }
    ]
  },
  "session": {
    "duration": 30,
    "turnLimit": 50,
    "tokenBudget": 8000,
    "retentionDays": 7
  },
  "rateLimit": {
    "requestsPerMinute": 30
  },
  "apiKeys": {
    "appKey": "wk-your-widget-key-here",
    "adminKey": "ak-your-admin-key-here"
  },
  "monitoring": {
    "budgetAmount": 50,
    "alarmEmail": "alerts@example.com"
  }
}
