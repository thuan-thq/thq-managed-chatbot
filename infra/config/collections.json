        { "key": "populate[heading][populate]", "value": "*" },
        {
          "key": "populate[components][on][dynamic.text-and-image][populate]",
          "value": "image"
        },
        {
          "key": "populate[components][on][dynamic.gallery][populate][items][populate]",
          "value": "*"
        },
        {
          "key": "populate[components][on][dynamic.text-quote-block][populate]",
          "value": "*"
        },
        {
          "key": "populate[components][on][dynamic.accordion][populate]",
          "value": "*"
        },
        {
          "key": "populate[components][on][dynamic.double-text-block][populate]",
          "value": "*"
        }
      ]
    },
    "urlPathTemplate": "/work/{slug}"
  },
