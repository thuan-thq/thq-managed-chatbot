[
  {
    "name": "case-studies",
    "strapiUid": "api::case-study.case-study",
    "markdownStrategy": "content-blocks",
    "fieldMappings": {
      "titleFields": ["title"],
      "slugField": "slug",
      "summaryField": "excerpt",
      "contentBlocksField": "components",
      "lastModifiedField": "updatedAt"
