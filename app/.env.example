# Build-time branding configuration
NEXT_PUBLIC_PRIMARY_COLOUR=#2563eb
NEXT_PUBLIC_ACCENT_COLOUR=#1d4ed8
NEXT_PUBLIC_LOGO_URL=
NEXT_PUBLIC_WIDGET_TITLE=Chat Assistant
NEXT_PUBLIC_FONT_FAMILY=system-ui, -apple-system, sans-serif
NEXT_PUBLIC_WELCOME_MESSAGE=Hi! How can I help you today?
NEXT_PUBLIC_BUBBLE_POSITION=bottom-right
NEXT_PUBLIC_API_ENDPOINT=https://your-api-gateway.execute-api.ap-southeast-2.amazonaws.com
# Lambda Function URL for streaming chat responses (POST /chat)
NEXT_PUBLIC_STREAM_ENDPOINT=https://your-function-url.lambda-url.ap-southeast-2.on.aws/
